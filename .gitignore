# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Secrets ---
.env
.env.*
!.env.example
# Dev-only pointer at the local API. No secrets, and a fresh clone needs it for
# `npm run dev`, so it is committed deliberately.
!web/.env.development

# --- Frontend ---
web/node_modules/
web/.next/
web/out/
web/.turbo/
*.tsbuildinfo

# --- Data artifacts (regenerate with scripts/ingest.py + scripts/build_index.py) ---
data/raw/
data/index/
data/index-*/
data/cache/
*.parquet

# --- Benchmark outputs (the committed report lives in reports/) ---
reports/raw/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Agent/editor local state ---
# Machine-local settings, plus the .tmp.<pid>.<hash> files written beside them
# during a save. Only the first is covered by the global ignore on one machine,
# and a `git add -A` racing a write either fails on the vanished temp file or
# commits local settings. A fresh clone gets neither, so cover both here.
.claude/settings.local.json
.claude/*.tmp.*

# --- Eval harness (BeaconBandhu/rag-local-eval-loop) ---
# A local clone of the upstream tool, kept only to diff against; not ours to ship.
rag-local-eval-loop/
# Timestamped run outputs. The numbers that back a claim belong in reports/,
# quoted deliberately, rather than as a directory of every run ever made.
results/
