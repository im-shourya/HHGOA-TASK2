# Copy to `.env` and fill in what you have. Every value is optional:
# the pipeline runs fully offline in extractive mode with browser-side STT
# when no keys are set.

# --- Speech-to-text (pick one provider; "auto" tries Sarvam first, then ElevenLabs)
# Sarvam: https://dashboard.sarvam.ai/ -> API keys
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
# ElevenLabs: https://elevenlabs.io -> Profile -> API keys
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
# sarvam | elevenlabs | auto | none (none = browser transcription only)
STT_PROVIDER=auto

# --- LLM answer mode (optional). Without a key the pipeline uses the
#     extractive composer, which cannot hallucinate by construction.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# extractive | llm | auto (auto = LLM only when the 200 ms budget allows)
GENERATION_MODE=extractive

# --- Latency budget (ms) for the graded core path ---
CORE_BUDGET_MS=200

# --- Retrieval confidence floor. 0.67 is the value measured from a real
#     holdout set in reports/benchmark.md — do not lower casually.
MIN_RETRIEVAL_SCORE=0.67

# --- Index / corpus locations ---
# INDEX_DIR=data/index
# CORPUS_DIR=data/corpus

# --- CORS origins for the dev frontend (comma-separated; "*" = anywhere) ---
CORS_ORIGINS=*